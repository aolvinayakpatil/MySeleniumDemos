public class A20_iplT20 {

	public static void main(String[] args) {

		WebDriver driver= new ChromeDriver();
		driver.manage().timeouts().implicitlyWait(Duration.ofSeconds(10));
		driver.manage().window().maximize();
		driver.get("https://www.iplt20.com/points-table/men/2024");
		//a.Display list of all the Teams
		List<WebElement> rows = driver.findElements(By.xpath("//*[@id=\"pointsdata\"]/tr/td[3]"));
		  for (WebElement row : rows) {
	            List<WebElement> columns = row.findElements(By.tagName("td"));
	            if (columns.size() > 8) {
	                String teamName = columns.get(2).getText();
	                String form = columns.get(8).getText();

	                int noResult = (form.length() - form.replace("N", "").length());
	                int wins = (form.length() - form.replace("W", "").length());
	                int losses = (form.length() - form.replace("L", "").length());

	                System.out.println(teamName + " " + form + " N-" + noResult + ", W-" + wins + ", L-" + losses);
	            }
	        }

		
