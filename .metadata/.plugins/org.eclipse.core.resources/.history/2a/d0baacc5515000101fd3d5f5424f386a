package com.Assignments;
/*21.Open https://istqb.in/
a.Display all 8 menus
*/
import java.time.Duration;
import java.util.List;

import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.chrome.ChromeDriver;
import org.openqa.selenium.interactions.Actions;


public class A21_DisplayAllMenus {

	public static void main(String[] args) throws InterruptedException {
		WebDriver driver = new ChromeDriver();
		driver.manage().window().maximize();
		driver.manage().timeouts().implicitlyWait(Duration.ofSeconds(10));
		driver.get("https://istqb.in/");
		
		Actions act = new Actions(driver);
		WebElement abtUs = driver.findElement(By.linkText("ABOUT US"));
		WebElement found = driver.findElement(By.xpath("//*[@id=\"sp-menu\"]/div/nav/ul/li[3]"));
		WebElement adv = driver.findElement(By.xpath("//*[@id=\"sp-menu\"]/div/nav/ul/li[4]"));
		WebElement agl = driver.findElement(By.xpath("//*[@id=\"sp-menu\"]/div/nav/ul/li[5]"));
		WebElement newCert = driver.findElement(By.xpath("//*[@id=\"sp-menu\"]/div/nav/ul/li[7]"));
		System.out.println("***ABOUT US-->SubMenus***");
		act.moveToElement(driver.findElement(By.linkText("ABOUT US"))).perform();
		Thread.sleep(2000);
		List<WebElement>abtMenus = driver.findElements(By.xpath("//*[@id=\"sp-menu\"]/div/nav/ul/li[2]/div/div/div/div/ul[1]/li"));
		for(WebElement ab : abtMenus)
			System.out.println(ab.getText());
		System.out.println("***FOUNDATION-->SubMenus***");
		act.moveToElement(abtUs).pause(2000).moveToElement(found).perform();
		Thread.sleep(2000);
		List<WebElement>foundationMenus = driver.findElements(By.xpath("//*[@id=\"sp-menu\"]/div/nav/ul/li[3]/div/div/div/div/ul/li"));
		for(WebElement fn : foundationMenus)
			System.out.println(fn.getText());	
		System.out.println("***ADVANCED-->SubMenus***");
		act.moveToElement(found).pause(2000).moveToElement(adv).perform();
		Thread.sleep(2000);
		List<WebElement>advMenus = driver.findElements(By.xpath("//*[@id=\"sp-menu\"]/div/nav/ul/li[4]/div/div/div/div/ul/li"));
		for(WebElement ad : advMenus)
			System.out.println(ad.getText());
		System.out.println("***AGILE-->SubMenus***");
		act.moveToElement(adv).pause(2000).moveToElement(agl).perform();
		Thread.sleep(2000);
		List<WebElement>aglMenus = driver.findElements(By.xpath("//*[@id=\"sp-menu\"]/div/nav/ul/li[5]/div/div/div/div/ul/li"));
		for(WebElement ag : aglMenus)
			System.out.println(ag.getText());
		System.out.println("***NEW CERTIFICATION-->SubMenus***");
		act.moveToElement(agl).pause(2000).moveToElement(newCert).perform();
		Thread.sleep(2000);
		List<WebElement>newCertMenus = driver.findElements(By.xpath("//*[@id=\"sp-menu\"]/div/nav/ul/li[7]/div/div/div/div/ul/li"));
		for(WebElement nc : newCertMenus)
			System.out.println(nc.getText());
		
		//driver.close();
	}

}
